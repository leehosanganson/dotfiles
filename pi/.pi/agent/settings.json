{
  "lastChangelogVersion": "1.3.0",
  "theme": "dark",
  "defaultProvider": "litellm",
  "defaultModel": "chatgpt/gpt-6.2-sol",
  "defaultProjectTrust": "true",
  "enabledModels": [
    "openrouter/deepseek-v4-flash",
    "openrouter/gpt-6-luna",
    "chatgpt/gpt-6-luna",
    "chatgpt/gpt-6.2-sol",
    "chatgpt/gpt-6.2-astra",
    "unsloth/qwen-3.8"
  ],
  "powerline": {
    "preset": "minimal",
    "welcome": false,
    "workingVibes": false
  },
  "packages": [
    "npm:pi-lsp",
    "npm:pi-powerline-footer",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-web-access",
    "npm:pi-subagents@0.90.0",
    "../../dotfiles/pi/system-one"
  ],
  "defaultThinkingLevel": "medium",
  "outputStyle": "eli5.md",
  "defaultTools": ["+codemode", "+system_one"],
  "hideThinkingBlock": true,
  "subagents": {
    "maxSubagentDepth": 1,
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "litellm/openrouter/gpt-6-luna",
        "litellm/openrouter/deepseek-v4-flash",
        "litellm/chatgpt/gpt-6-luna",
        "litellm/chatgpt/gpt-6.2-sol",
        "litellm/chatgpt/gpt-6.2-astra",
        "litellm/unsloth/qwen-3.8"
      ]
    },
    "agentOverrides": {
      "explorer": {
        "tools": ["read", "ls"],
        "subagentOnlyExtensions": [
          "~/dotfiles/pi/system-one/src/evaluator-file-guard.ts"
        ]
      },
      "evaluator": {
        "tools": ["read", "ls"],
        "subagentOnlyExtensions": [
          "~/dotfiles/pi/system-one/src/evaluator-file-guard.ts"
        ]
      },
      "coder": { "disabled": true },
      "content": { "disabled": true },
      "homelab": { "disabled": true }
    }
  }
}
