{
  "searxngBaseUrl": "https://searxng.homelab.leehosanganson.dev",
  "webSearch": {
    "enabled": true,
    "allowedProviders": ["searxng"]
  },
  "searchRouting": {
    "providers": ["searxng"],
    "fallbackOn": ["network"]
  },
  "fetchRouting": {
