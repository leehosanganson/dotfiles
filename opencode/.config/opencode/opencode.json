{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "rules/AGENTS.md",
    "rules/bash-tool-usage.md",
    "rules/web-search.md"
  ],
  "default_agent": "coder",
  "subagent_depth": 2,
  "model": "openrouter/gpt-5.6-luna",
  "small_model": "unsloth/qwen-3.8",
  "permission": {
    "github_*": "allow",
    "searxng_*": "allow",
    "bash": {
      "kubectl *": "allow",
      "ssh *": "allow",
      "make *": "allow",
      "uv run *": "allow",
      "go *": "allow",
      "docker *": "allow",
      "git *": "allow",
      "gh *": "allow",
      "nix *": "allow",
      "terraform *": "allow",
      "helm *": "allow",
      "k9s *": "allow",
      "rm -f *": "ask",
      "rm -rf *": "ask",
      "git reset --hard*": "deny",
      "git rebase *": "deny",
      "git push * --force*": "deny"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16384
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://litellm.leehosanganson.dev",
        "apiKey": "{file:~/.config/sops-nix/secrets/litellm-api-key}",
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true
      },
      "models": {
        "unsloth/qwen-3.8": { "limit": { "context": 60000, "output": 5096 } },
        "openrouter/deepseek-v4-flash": {},
        "openrouter/gpt-5.6-luna": {}
      }
    },
    "opencode-go": {
      "options": {
        "apiKey": "{file:~/.config/sops-nix/secrets/opencode-api-key}"
      }
    }
  },
  "mcp": {
    "github": {
      "enabled": true,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {file:~/.config/sops-nix/secrets/opencode-github-pat}"
      }
    },
    "searxng": {
      "enabled": true,
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng"],
      "environment": {
        "SEARXNG_URL": "https://searxng.homelab.leehosanganson.dev"
      }
    }
  }
}
